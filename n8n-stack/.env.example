# Salin ke .env lalu isi dengan nilai asli. File .env TIDAK boleh di-commit
# (sudah tercakup pola .env* di .gitignore root).
#
# Nilai acak dapat dibuat dengan: openssl rand -hex 32

# --- Postgres (dipakai bersama oleh n8n dan Evolution API) ---
POSTGRES_USER=barberflow
POSTGRES_PASSWORD=

# --- n8n ---
# URL publik lengkap beserta skema, tanpa garis miring di akhir.
N8N_PUBLIC_URL=https://n8n.takhtabarber.shop
# Hostname saja, tanpa skema.
N8N_HOSTNAME=n8n.takhtabarber.shop
# Untuk server di balik Cloudflare Tunnel biarkan kosong (default https / 1
# proxy hop). Untuk menjalankan di lokal, isi: N8N_PROTOCOL=http dan
# N8N_PROXY_HOPS=0.
N8N_PROTOCOL=
N8N_PROXY_HOPS=
# JANGAN diubah setelah ada kredensial tersimpan di n8n.
N8N_ENCRYPTION_KEY=

# --- Evolution API ---
EVOLUTION_PUBLIC_URL=https://evo.takhtabarber.shop
# Satu-satunya pelindung Evolution API. Wajib acak dan panjang.
EVOLUTION_API_KEY=
