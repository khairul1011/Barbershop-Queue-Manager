      {
        "id": "74aa0449-2a48-42da-93d9-adbc797481e6",
        "name": "Ambil Tagihan",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [
          224,
          320
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "-- Selalu satu baris. pr null = tagihan tidak ditemukan atau belum punya QR.\nselect coalesce(wa.xendit_qr_id, qe.payment_xendit_qr_id) as pr,\n       coalesce(wa.dp_amount, qe.payment_qr_amount) as amount,\n       coalesce(wa.payment_status::text <> 'unpaid', qe.payment_method = 'qris', false) as lunas\n  from (select 1) satu\n  left join public.whatsapp_requests wa on $2 <> 'queue' and wa.id::text = $1\n  left join public.queue_entries qe on $2 = 'queue' and qe.id::text = $1",
          "options": {
            "queryReplacement": "={{ [String($json.body.id ?? ''), String($json.body.type ?? 'wa')] }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "bzISw2QfqVYUFsSu",
            "name": "Postgres account"
          }
        }
      },
      {
