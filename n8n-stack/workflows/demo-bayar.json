      {
        "id": "e3e6c507-b2bf-4b81-8c5f-0f7e2eb5f674",
        "name": "Ambil Daftar Tagihan",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [
          224,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "-- Tagihan yang bisa disimulasikan: DP WhatsApp yang belum dibayar (terbaru dulu),\n-- lalu sisa pembayaran QRIS dari dashboard. Selalu mengembalikan satu baris.\nselect coalesce(json_agg(t), '[]'::json) as rows from (\n  (select id::text as id, 'wa' as type, sender_name as name, dp_amount as amount,\n          concat_ws(', ', extracted_day, extracted_time)\n            || coalesce(' -- ' || nullif(split_part(extracted_service, '|', 1), ''), '') as detail\n     from public.whatsapp_requests\n    where payment_status = 'unpaid' and xendit_qr_id is not null\n    order by received_at desc limit 10)\n  union all\n  (select id::text, 'queue', customer_name, payment_qr_amount, 'Sisa pembayaran sesi (dashboard)'\n     from public.queue_entries\n    where payment_method is null and payment_xendit_qr_id is not null\n    order by created_at desc limit 10)\n) t",
          "options": {}
        },
        "credentials": {
          "postgres": {
            "id": "bzISw2QfqVYUFsSu",
            "name": "Postgres account"
          }
        }
      },
      {
        "id": "f0a5628a-7cfa-4f4c-a61c-70ec7bcb623e",
        "name": "Balas Daftar",
