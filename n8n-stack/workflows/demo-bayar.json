            "conditions": [
              {
                "leftValue": "={{ !!$json.pr }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ]
          }
        }
      },
