      {
        "id": "5758a30b-157f-4ce7-b1a9-9524b9109a6d",
        "name": "Tandai Lunas",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.7,
        "position": [
          448,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "-- Korelasi WAJIB lewat payment_request_id (= xendit_qr_id), bukan reference_id.\n-- Transisi ke paid atomik: retry Xendit yang datang bersamaan hanya\n-- mengembalikan baris sekali, jadi notifikasi tidak terkirim dua kali.\nwith wa as (\n  update public.whatsapp_requests\n     set payment_status = 'paid', dp_paid_at = now()\n   where xendit_qr_id = $1 and payment_status <> 'paid'\n  returning id, sender_wa_id, sender_name, payment_notified\n), sisa_bayar as (\n  -- Bukan DP WhatsApp: sisa pembayaran QRIS dari dashboard.\n  update public.queue_entries\n     set payment_method = 'qris'\n   where payment_xendit_qr_id = $1\n     and payment_method is distinct from 'qris'\n     and not exists (select 1 from public.whatsapp_requests where xendit_qr_id = $1)\n  returning id\n)\nselect (select row_to_json(wa) from wa) as wa,\n  (select count(*) from sisa_bayar) as sisa_bayar_ditandai",
          "options": {
            "queryReplacement": "={{ [$json.body.data.payment_request_id] }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "bzISw2QfqVYUFsSu",
            "name": "Postgres account"
          }
        }
      },
