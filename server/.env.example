GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Dipakai bot (supabaseClient.js) buat bypass RLS -- prioritas di atas
# SUPABASE_ANON_KEY kalau dua-duanya ada. Wajib diisi di VPS.
SUPABASE_SERVICE_ROLE_KEY=

# Xendit (mode Test/Sandbox dulu -- lihat PROJECT.md soal fitur DP QRIS)
XENDIT_SECRET_KEY=
# Harus sama persis dengan "Verification Token" di Xendit Dashboard >
# Settings > Webhooks, dipakai buat verifikasi header x-callback-token.
XENDIT_CALLBACK_TOKEN=
# Port lokal buat webhook Xendit -- diakses publik lewat Cloudflare Tunnel,
# bukan langsung. Jangan diubah tanpa update juga config Cloudflare Tunnel-nya.
WEBHOOK_PORT=3002
