GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Digunakan bot (supabaseClient.js) untuk melewati RLS — memiliki prioritas
# di atas SUPABASE_ANON_KEY apabila keduanya diisi. Wajib diisi di VPS.
SUPABASE_SERVICE_ROLE_KEY=

# Xendit (menggunakan mode Test/Sandbox untuk saat ini — lihat PROJECT.md mengenai fitur DP QRIS)
XENDIT_SECRET_KEY=
# Harus sama persis dengan "Verification Token" pada Xendit Dashboard >
# Settings > Webhooks, digunakan untuk verifikasi header x-callback-token.
XENDIT_CALLBACK_TOKEN=
# Port lokal untuk webhook Xendit — diakses publik melalui Cloudflare Tunnel,
# bukan secara langsung. Jangan diubah tanpa memperbarui konfigurasi Cloudflare Tunnel juga.
WEBHOOK_PORT=3002
# Passcode untuk halaman demo "/demo" (simulasi pembayaran dari HP saat demo ke
# barber) — BUKAN mekanisme keamanan produksi, hanya untuk mencegah akses
# sembarangan terhadap data test customer. Bebas menggunakan string acak apa pun.
DEMO_SECRET=
# Origin dashboard frontend yang diizinkan memanggil /api/session-payment (CORS),
# dipisahkan koma apabila lebih dari satu (misalnya domain produksi + localhost dev).
# Tanpa protokol yang salah/trailing slash — harus sama persis dengan yang dikirim
# browser pada header Origin, contoh: https://dashboard.takhtabarber.shop
DASHBOARD_ORIGINS=
